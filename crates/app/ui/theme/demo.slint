// ============================================================================
//  Theme Demo — Tüm bileşenlerin dark/light gösterimi
// ============================================================================

import { Palette, ScrollView } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import {
    ThemeToggle, TCard, TButton, TBadge, TInput,
    TStatusDot, TSeparator, TMotorButton, TSensorValue,
    ButtonVariant, BadgeVariant, StatusLevel
} from "components.slint";


export component ThemeDemo inherits Window {
    title: "AppTheme Showcase";
    preferred-width: 860px;
    preferred-height: 720px;
    background: AppTheme.bg;

    animate background { duration: 200ms; }

    ScrollView {
        VerticalLayout {
            padding: AppTheme.space-2xl;
            spacing: AppTheme.space-2xl;

            // ── Header ──
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "AppTheme Showcase";
                        color: AppTheme.text-primary;
                        font-size: AppTheme.font-2xl;
                        font-weight: 700;
                    }
                    Text {
                        text: AppTheme.dark ? "Dark Mode" : "Light Mode";
                        color: AppTheme.text-secondary;
                        font-size: AppTheme.font-sm;
                    }
                }

                ThemeToggle {
                    vertical-alignment: center;
                }
            }

            TSeparator {}

            // ── Buttons Section ──
            TCard {
                title: "Buttons";

                HorizontalLayout {
                    spacing: AppTheme.space-md;

                    TButton { label: "Primary"; variant: ButtonVariant.primary; }
                    TButton { label: "Secondary"; variant: ButtonVariant.secondary; }
                    TButton { label: "Danger"; variant: ButtonVariant.danger; }
                    TButton { label: "Ghost"; variant: ButtonVariant.ghost; }
                    TButton { label: "Disabled"; enabled: false; }
                }
            }

            // ── Badges Section ──
            TCard {
                title: "Status Badges";

                HorizontalLayout {
                    spacing: AppTheme.space-md;

                    TBadge { label: "Online"; variant: BadgeVariant.success; }
                    TBadge { label: "Dikkat"; variant: BadgeVariant.warning; }
                    TBadge { label: "Arıza"; variant: BadgeVariant.error; }
                    TBadge { label: "Bilgi"; variant: BadgeVariant.info; }
                    TBadge { label: "Pasif"; variant: BadgeVariant.neutral; }
                }
            }

            // ── Input Section ──
            TCard {
                title: "Input";

                VerticalLayout {
                    spacing: AppTheme.space-md;

                    HorizontalLayout {
                        spacing: AppTheme.space-md;

                        TInput {
                            placeholder: "Normal input...";
                            horizontal-stretch: 1;
                        }
                        TInput {
                            placeholder: "Hata durumu";
                            has-error: true;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // ── Motor Controls ──
            TCard {
                title: "Motor Controls";

                HorizontalLayout {
                    spacing: AppTheme.space-md;

                    TMotorButton {
                        motor-name: "Pompa";
                        running: false;
                        clicked => { self.running = !self.running; }
                    }
                    TMotorButton {
                        motor-name: "Fan";
                        running: true;
                        clicked => { self.running = !self.running; }
                    }
                    TMotorButton {
                        motor-name: "Kompresör";
                        fault: true;
                    }
                    TMotorButton {
                        motor-name: "Vana";
                        enabled: false;
                    }
                }
            }

            // ── Sensor Values ──
            TCard {
                title: "Sensor Monitoring";

                HorizontalLayout {
                    spacing: AppTheme.space-lg;

                    TSensorValue {
                        label: "Sıcaklık";
                        value: "24.5";
                        unit: "°C";
                        status: StatusLevel.online;
                        horizontal-stretch: 1;
                    }
                    TSensorValue {
                        label: "Nem";
                        value: "78";
                        unit: "%RH";
                        status: StatusLevel.warning;
                        horizontal-stretch: 1;
                    }
                    TSensorValue {
                        label: "Basınç";
                        value: "--";
                        unit: "bar";
                        status: StatusLevel.offline;
                        horizontal-stretch: 1;
                    }
                    TSensorValue {
                        label: "Akım";
                        value: "3.2";
                        unit: "A";
                        status: StatusLevel.idle;
                        horizontal-stretch: 1;
                    }
                }
            }

            // ── Status Dots ──
            TCard {
                title: "Status Indicators";

                HorizontalLayout {
                    spacing: AppTheme.space-2xl;

                    for item in [
                        { level: StatusLevel.online,  name: "Online" },
                        { level: StatusLevel.warning, name: "Warning" },
                        { level: StatusLevel.offline, name: "Offline" },
                        { level: StatusLevel.idle,    name: "Idle" },
                    ] : HorizontalLayout {
                        spacing: AppTheme.space-md;
                        alignment: center;

                        TStatusDot { status: item.level; }
                        Text {
                            text: item.name;
                            color: AppTheme.text-secondary;
                            font-size: AppTheme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── Color Palette Showcase ──
            TCard {
                title: "Color Palette";

                VerticalLayout {
                    spacing: AppTheme.space-lg;

                    // Yüzey renkleri
                    Text {
                        text: "Surfaces";
                        color: AppTheme.text-secondary;
                        font-size: AppTheme.font-sm;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        for c in [
                            { color: AppTheme.bg,              name: "bg" },
                            { color: AppTheme.bg-secondary,    name: "bg-sec" },
                            { color: AppTheme.surface,         name: "surface" },
                            { color: AppTheme.surface-raised,  name: "raised" },
                            { color: AppTheme.surface-overlay, name: "overlay" },
                        ] : VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 36px;
                                background: c.color;
                                border-radius: AppTheme.radius-sm;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                            }
                            Text {
                                text: c.name;
                                color: AppTheme.text-tertiary;
                                font-size: AppTheme.font-xs;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Semantic renkleri
                    Text {
                        text: "Semantic";
                        color: AppTheme.text-secondary;
                        font-size: AppTheme.font-sm;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        for c in [
                            { color: AppTheme.accent,  name: "accent" },
                            { color: AppTheme.success, name: "success" },
                            { color: AppTheme.warning, name: "warning" },
                            { color: AppTheme.error,   name: "error" },
                            { color: AppTheme.info,    name: "info" },
                        ] : VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 36px;
                                background: c.color;
                                border-radius: AppTheme.radius-sm;
                            }
                            Text {
                                text: c.name;
                                color: AppTheme.text-tertiary;
                                font-size: AppTheme.font-xs;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Subtle renkleri
                    Text {
                        text: "Subtle Backgrounds";
                        color: AppTheme.text-secondary;
                        font-size: AppTheme.font-sm;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        for c in [
                            { color: AppTheme.accent-subtle,  name: "accent" },
                            { color: AppTheme.success-subtle, name: "success" },
                            { color: AppTheme.warning-subtle, name: "warning" },
                            { color: AppTheme.error-subtle,   name: "error" },
                            { color: AppTheme.info-subtle,    name: "info" },
                        ] : VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 36px;
                                background: c.color;
                                border-radius: AppTheme.radius-sm;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                            }
                            Text {
                                text: c.name;
                                color: AppTheme.text-tertiary;
                                font-size: AppTheme.font-xs;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Typography ──
            TCard {
                title: "Typography";

                VerticalLayout {
                    spacing: AppTheme.space-md;

                    Text { text: "font-3xl: 30px Heading"; color: AppTheme.text-primary; font-size: AppTheme.font-3xl; font-weight: 700; }
                    Text { text: "font-2xl: 24px Heading"; color: AppTheme.text-primary; font-size: AppTheme.font-2xl; font-weight: 700; }
                    Text { text: "font-xl: 20px Subheading"; color: AppTheme.text-primary; font-size: AppTheme.font-xl; font-weight: 600; }
                    Text { text: "font-lg: 16px Large text"; color: AppTheme.text-primary; font-size: AppTheme.font-lg; }
                    Text { text: "font-md: 14px Body text (default)"; color: AppTheme.text-secondary; font-size: AppTheme.font-md; }
                    Text { text: "font-sm: 12px Small / Caption"; color: AppTheme.text-tertiary; font-size: AppTheme.font-sm; }
                    Text { text: "font-xs: 10px Extra small / Label"; color: AppTheme.text-tertiary; font-size: AppTheme.font-xs; }
                }
            }

            // Footer space
            Rectangle { height: AppTheme.space-xl; }
        }
    }
}
