import { AppState }          from "../state.slint";
import { AppTheme }          from "../theme/theme.slint";
import { TMotorButton, TCard } from "../theme/components.slint";
import { SpinBox, Button, ComboBox } from "std-widgets.slint";

export component MotorControl {
    callback start();
    callback stop();
    callback set-gear(int);
    callback set-light(bool);
    callback set-brake(bool);
    callback set-reverse-l(bool);
    callback set-reverse-r(bool);
    callback set-send-interval(int);

    VerticalLayout {
        spacing: AppTheme.space-md;

        // ── Başlık ──
        Text {
            text: "MOTOR KONTROL";
            color: AppTheme.text-secondary;
            font-size: AppTheme.font-xs;
            font-weight: 600;
            letter-spacing: 1.5px;
        }

        // ── Başlat/Durdur — TMotorButton ──
        TMotorButton {
            motor-name: "Motor";
            running: AppState.motor-running;
            enabled: AppState.connected;
            clicked => {
                if (AppState.motor-running) {
                    root.stop();
                } else {
                    root.start();
                }
            }
        }

        // ── Vites ──
        HorizontalLayout {
            spacing: AppTheme.space-md;
            alignment: stretch;

            Text {
                text: "Vites:";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
            }

            SpinBox {
                minimum: 1;
                maximum: 3;
                value: AppState.gear;
                horizontal-stretch: 1;
                edited(v) => { root.set-gear(v); }
            }
        }

        // ── Gönderim Aralığı ──
        HorizontalLayout {
            spacing: AppTheme.space-md;
            alignment: stretch;

            Text {
                text: "Gönd. Aralığı:";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
            }

            interval-box := ComboBox {
                model: ["10 ms", "20 ms", "30 ms", "40 ms", "50 ms"];
                current-index: 2;  // varsayılan: 30ms
                horizontal-stretch: 1;
                enabled: !AppState.motor-running;
                selected(val) => {
                    if (val == "10 ms")      { root.set-send-interval(10); }
                    else if (val == "20 ms") { root.set-send-interval(20); }
                    else if (val == "30 ms") { root.set-send-interval(30); }
                    else if (val == "40 ms") { root.set-send-interval(40); }
                    else if (val == "50 ms") { root.set-send-interval(50); }
                }
            }
        }

        // ── Işık ve Fren ──
        HorizontalLayout {
            spacing: AppTheme.space-sm;

            Button {
                text: AppState.light-on ? "💡 IŞIK ✓" : "💡 IŞIK";
                horizontal-stretch: 1;
                clicked => { root.set-light(!AppState.light-on); }
            }

            Button {
                text: AppState.brake-on ? "🛑 FREN ✓" : "🛑 FREN";
                horizontal-stretch: 1;
                clicked => { root.set-brake(!AppState.brake-on); }
            }
        }

        // ── Motor ters bağlantı (sırt sırta) ──
        HorizontalLayout {
            spacing: AppTheme.space-sm;

            Button {
                text: AppState.reverse-left ? "↺ Sol Ters ✓" : "↺ Sol Ters";
                horizontal-stretch: 1;
                clicked => {
                    if (!AppState.reverse-left) {
                        AppState.reverse-right = false;
                    }
                    root.set-reverse-l(!AppState.reverse-left);
                }
            }

            Button {
                text: AppState.reverse-right ? "↻ Sağ Ters ✓" : "↻ Sağ Ters";
                horizontal-stretch: 1;
                clicked => {
                    if (!AppState.reverse-right) {
                        AppState.reverse-left = false;
                    }
                    root.set-reverse-r(!AppState.reverse-right);
                }
            }
        }
    }
}
