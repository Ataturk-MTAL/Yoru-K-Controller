import { AppState }          from "../state.slint";
import { AppTheme }          from "../theme/theme.slint";
import { TMotorButton, TCard } from "../theme/components.slint";
import { SpinBox }           from "std-widgets.slint";

export component MotorControl {
    callback start();
    callback stop();
    callback set-gear(int);
    callback set-light(bool);
    callback set-brake(bool);
    callback set-reverse-l(bool);
    callback set-reverse-r(bool);

    VerticalLayout {
        spacing: AppTheme.space-md;

        // ── Başlık ──
        Text {
            text: "MOTOR KONTROL";
            color: AppTheme.text-secondary;
            font-size: AppTheme.font-xs;
            font-weight: 600;
            letter-spacing: 1.5px;
        }

        // ── Başlat/Durdur — TMotorButton ──
        TMotorButton {
            motor-name: "Motor";
            running: AppState.motor-running;
            enabled: AppState.connected;
            clicked => {
                if (AppState.motor-running) {
                    root.stop();
                } else {
                    root.start();
                }
            }
        }

        // ── Vites ──
        HorizontalLayout {
            spacing: AppTheme.space-md;
            alignment: stretch;

            Text {
                text: "Vites:";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
            }

            SpinBox {
                minimum: 1;
                maximum: 3;
                value: AppState.gear;
                horizontal-stretch: 1;
                edited(v) => { root.set-gear(v); }
            }
        }

        // ── Işık ve Fren ──
        HorizontalLayout {
            spacing: AppTheme.space-sm;

            // Işık toggle
            light-rect := Rectangle {
                border-color: AppTheme.border-default;
                border-width: 1px;
                border-radius: AppTheme.radius-md;
                height: 32px;
                horizontal-stretch: 1;
                background: AppState.light-on ? AppTheme.warning : AppTheme.control-bg;
                animate background { duration: AppTheme.anim-fast; }

                HorizontalLayout {
                    alignment: center;
                    spacing: AppTheme.space-sm;
                    padding-left: AppTheme.space-md;
                    padding-right: AppTheme.space-md;

                    Text {
                        text: "💡";
                        font-size: AppTheme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "IŞIK";
                        font-size: AppTheme.font-sm;
                        font-weight: 500;
                        color: AppState.light-on ? AppTheme.text-inverse : AppTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.set-light(!AppState.light-on); }
                }
            }

            // Fren toggle
            brake-rect := Rectangle {
                border-color: AppTheme.border-default;
                border-width: 1px;
                border-radius: AppTheme.radius-md;
                height: 32px;
                horizontal-stretch: 1;
                background: AppState.brake-on ? AppTheme.error : AppTheme.control-bg;
                animate background { duration: AppTheme.anim-fast; }

                HorizontalLayout {
                    alignment: center;
                    spacing: AppTheme.space-sm;
                    padding-left: AppTheme.space-md;
                    padding-right: AppTheme.space-md;

                    Text {
                        text: "🛑";
                        font-size: AppTheme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "FREN";
                        font-size: AppTheme.font-sm;
                        font-weight: 500;
                        color: AppState.brake-on ? #ffffff : AppTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.set-brake(!AppState.brake-on); }
                }
            }
        }

        // ── Motor ters bağlantı (sırt sırta) ──
        HorizontalLayout {
            spacing: AppTheme.space-sm;

            // Sol ters
            Rectangle {
                border-color: AppTheme.border-default;
                border-width: 1px;
                border-radius: AppTheme.radius-md;
                height: 28px;
                horizontal-stretch: 1;
                background: AppState.reverse-left ? AppTheme.warning-subtle : AppTheme.control-bg;
                animate background { duration: AppTheme.anim-fast; }

                Text {
                    text: "↺ Sol Ters";
                    font-size: AppTheme.font-sm;
                    color: AppState.reverse-left ? AppTheme.warning-text : AppTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        // Mutex: ikisi aynı anda aktif olamaz
                        if (!AppState.reverse-left) {
                            AppState.reverse-right = false;
                        }
                        root.set-reverse-l(!AppState.reverse-left);
                    }
                }
            }

            // Sağ ters
            Rectangle {
                border-color: AppTheme.border-default;
                border-width: 1px;
                border-radius: AppTheme.radius-md;
                height: 28px;
                horizontal-stretch: 1;
                background: AppState.reverse-right ? AppTheme.warning-subtle : AppTheme.control-bg;
                animate background { duration: AppTheme.anim-fast; }

                Text {
                    text: "↻ Sağ Ters";
                    font-size: AppTheme.font-sm;
                    color: AppState.reverse-right ? AppTheme.warning-text : AppTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (!AppState.reverse-right) {
                            AppState.reverse-left = false;
                        }
                        root.set-reverse-r(!AppState.reverse-right);
                    }
                }
            }
        }
    }
}
