import { AppState, MapTile } from "../state.slint";
import { AppTheme }         from "../theme/theme.slint";
import { Slider }           from "std-widgets.slint";

// ─────────────────────────────────────────────────────────────────────────────
// MapView — OpenStreetMap tile haritası + GPS robot marker
// ─────────────────────────────────────────────────────────────────────────────
export component MapView {
    callback enable-gps();
    callback disable-gps();
    callback map-flicked(/* viewport-x */ length, /* viewport-y */ length);
    callback map-zoom-changed(/* zoom */ int);
    callback map-zoom-in(/* mouse-x */ length, /* mouse-y */ length);
    callback map-zoom-out(/* mouse-x */ length, /* mouse-y */ length);

    // Viewport boyutu — Rust tarafı okur
    out property <length> visible-width:  fli.width;
    out property <length> visible-height: fli.height;

    // Pencere resize → tile sistemini güncelle
    changed visible-width  => { root.map-flicked(fli.viewport-x, fli.viewport-y); }
    changed visible-height => { root.map-flicked(fli.viewport-x, fli.viewport-y); }

    // Rust'tan viewport ayarı (zoom değiştiğinde çağrılır)
    public function set-viewport(ox: length, oy: length, w: length, h: length) {
        fli.viewport-x = ox;
        fli.viewport-y = oy;
        fli.viewport-width = w;
        fli.viewport-height = h;
    }

    // ── Arkaplan ─────────────────────────────────────────
    Rectangle {
        background: AppTheme.bg;

        // ── Tile harita alanı ────────────────────────────
        fli := Flickable {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height - zoom-bar.height;

            for t in AppState.map-tiles: Image {
                x: t.x;
                y: t.y;
                width: 256px;
                height: 256px;
                source: t.tile;
            }

            flicked => {
                root.map-flicked(fli.viewport-x, fli.viewport-y);
            }

            // Scroll ile zoom
            TouchArea {
                scroll-event(e) => {
                    if (e.delta-y > 0) {
                        root.map-zoom-in(
                            self.mouse-x + fli.viewport-x,
                            self.mouse-y + fli.viewport-y
                        );
                        return accept;
                    } else if (e.delta-y < 0) {
                        root.map-zoom-out(
                            self.mouse-x + fli.viewport-x,
                            self.mouse-y + fli.viewport-y
                        );
                        return accept;
                    }
                    return reject;
                }
            }

            // Robot marker — GPS aktifken görünür
            if (AppState.gps-active && AppState.gps-point-count > 0): Rectangle {
                x: AppState.map-marker-x - self.width / 2;
                y: AppState.map-marker-y - self.height / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: AppTheme.success;
                border-color: white;
                border-width: 2px;
                animate x { duration: 200ms; easing: ease-out; }
                animate y { duration: 200ms; easing: ease-out; }

                // Etrafında titreşen halka
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    border-color: AppTheme.success.transparentize(60%);
                    border-width: 2px;
                }
            }
        }

        // ── Zoom slider (alt çubuk) ──────────────────────
        zoom-bar := HorizontalLayout {
            y: parent.height - self.height;
            height: 32px;
            padding-left: AppTheme.space-xl;
            padding-right: AppTheme.space-xl;
            spacing: AppTheme.space-md;

            Text {
                text: "−";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-lg;
                vertical-alignment: center;
            }

            Slider {
                minimum: 1;
                maximum: 19;
                value: AppState.map-zoom;
                horizontal-stretch: 1;
                released => {
                    root.map-zoom-changed(round(self.value));
                }
            }

            Text {
                text: "+";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-lg;
                vertical-alignment: center;
            }

            Text {
                text: "z" + AppState.map-zoom;
                color: AppTheme.text-tertiary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
                width: 30px;
            }
        }

        // ── GPS butonu (sol alt) ─────────────────────────
        HorizontalLayout {
            y: parent.height - zoom-bar.height - self.height - 8px;
            x: 8px;
            spacing: AppTheme.space-sm;
            width: 200px;
            height: 32px;

            Rectangle {
                background: AppState.gps-active ? AppTheme.error : AppTheme.success;
                border-radius: AppTheme.radius-md;
                horizontal-stretch: 1;
                animate background { duration: AppTheme.anim-fast; }

                Text {
                    text: AppState.gps-active ? "■ GPS Durdur" : "▶ GPS Başlat";
                    color: black;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (AppState.gps-active) {
                            root.disable-gps();
                        } else {
                            root.enable-gps();
                        }
                    }
                }
            }
        }

        // ── Koordinat overlay (sağ üst) ──────────────────
        if (AppState.gps-active && AppState.gps-point-count > 0): Rectangle {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: coord-layout.preferred-width + 16px;
            height: coord-layout.preferred-height + 8px;
            background: AppTheme.scrim;
            border-radius: AppTheme.radius-md;

            coord-layout := VerticalLayout {
                padding: AppTheme.space-sm;
                spacing: 2px;

                Text {
                    text: "● GPS  " + AppState.gps-point-count + " pkt";
                    color: AppTheme.success;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                }
                Text {
                    text: round(AppState.gps-lat * 10000) / 10000 + "° "
                        + (AppState.gps-lat >= 0.0 ? "N" : "S");
                    color: AppTheme.text-primary;
                    font-size: AppTheme.font-sm;
                }
                Text {
                    text: round(AppState.gps-lon * 10000) / 10000 + "° "
                        + (AppState.gps-lon >= 0.0 ? "E" : "W");
                    color: AppTheme.text-primary;
                    font-size: AppTheme.font-sm;
                }
            }
        }

        // ── GPS aktif değilken sinyal yok göstergesi ─────
        if (!AppState.gps-active): Rectangle {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: no-gps-text.preferred-width + 16px;
            height: 22px;
            background: AppTheme.scrim;
            border-radius: AppTheme.radius-sm;

            no-gps-text := Text {
                text: "GPS kapalı";
                color: AppTheme.text-disabled;
                font-size: AppTheme.font-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 8px;
            }
        }

        // ── Bağlantı uyarısı ─────────────────────────────
        if (!AppState.connected): Rectangle {
            x: 8px; y: 8px;
            height: 24px;
            width: gps-warn.preferred-width + 16px;
            background: AppTheme.error-subtle;
            border-radius: AppTheme.radius-sm;
            border-width: 1px;
            border-color: AppTheme.error.transparentize(60%);

            gps-warn := Text {
                text: "Yörü-K Bağlı değil";
                color: AppTheme.error-text;
                font-size: AppTheme.font-sm;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 8px;
            }
        }

        // ── OSM attribution ──────────────────────────────
        Text {
            text: "© OpenStreetMap";
            color: AppTheme.text-disabled;
            font-size: 9px;
            x: parent.width - self.width - 4px;
            y: parent.height - zoom-bar.height - self.height - 4px;
        }
    }
}
