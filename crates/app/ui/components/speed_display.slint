import { AppState } from "../state.slint";
import { AppTheme } from "../theme/theme.slint";
import { TStatusDot, StatusLevel } from "../theme/components.slint";

// Tek motor hız çubuğu bileşeni
component SpeedBar {
    in property <string> label: "L";
    in property <int>    speed: 0;   // -100..100

    height: 36px;

    Rectangle {
        background: AppTheme.surface-sunken;
        border-radius: AppTheme.radius-md;

        HorizontalLayout {
            padding: AppTheme.space-sm;
            spacing: AppTheme.space-sm;
            alignment: center;

            // Etiket
            Text {
                text: label;
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
                width: 30px;
                horizontal-alignment: left;
            }

            // Geri yön çubuğu (negatif hız)
            Rectangle {
                background: AppTheme.bg-tertiary;
                border-radius: AppTheme.radius-sm;
                horizontal-stretch: 1;
                height: 12px;

                // Geri hız doldurma (sağdan sola)
                Rectangle {
                    background: speed < 0 ? AppTheme.error : transparent;
                    border-radius: AppTheme.radius-sm;
                    width: speed < 0 ? (parent.width * (-speed / 100.0)) : 0px;
                    x: parent.width - self.width;
                    height: parent.height;
                    animate width { duration: 80ms; }
                }
            }

            // Merkez işareti
            Rectangle {
                width: 2px; height: 16px;
                background: AppTheme.border-default;
            }

            // İleri yön çubuğu (pozitif hız)
            Rectangle {
                background: AppTheme.bg-tertiary;
                border-radius: AppTheme.radius-sm;
                horizontal-stretch: 1;
                height: 12px;

                Rectangle {
                    background: speed > 0 ? AppTheme.success : transparent;
                    border-radius: AppTheme.radius-sm;
                    width: speed > 0 ? (parent.width * (speed / 100.0)) : 0px;
                    height: parent.height;
                    animate width { duration: 80ms; }
                }
            }

            // Sayısal değer
            Text {
                text: (speed >= 0 ? "+" : "") + speed;
                color: speed > 0 ? AppTheme.success : (speed < 0 ? AppTheme.error : AppTheme.text-tertiary);
                font-size: AppTheme.font-sm;
                font-weight: 500;
                vertical-alignment: center;
                width: 32px;
                horizontal-alignment: right;
            }
        }
    }
}

export component SpeedDisplay {
    Rectangle {
        background: AppTheme.surface;
        border-radius: AppTheme.radius-lg;

        VerticalLayout {
            padding: AppTheme.space-lg;
            spacing: AppTheme.space-md;

            Text {
                text: "HIZ GÖSTERGESİ";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-xs;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            SpeedBar {
                label: "Sol";
                speed: AppState.left-speed;
            }

            SpeedBar {
                label: "Sağ";
                speed: AppState.right-speed;
            }

            // Vites göstergesi
            HorizontalLayout {
                alignment: center;
                spacing: AppTheme.space-md;

                Text {
                    text: "Vites:";
                    color: AppTheme.text-secondary;
                    font-size: AppTheme.font-sm;
                    vertical-alignment: center;
                }

                Text {
                    text: "V\{AppState.gear}";
                    color: AppTheme.warning;
                    font-size: AppTheme.font-lg;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Motor durumu
                TStatusDot {
                    status: AppState.motor-running ? StatusLevel.online : StatusLevel.idle;
                }

                Text {
                    text: AppState.motor-running ? "Çalışıyor" : "Durdu";
                    color: AppState.motor-running ? AppTheme.success : AppTheme.text-tertiary;
                    font-size: AppTheme.font-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
