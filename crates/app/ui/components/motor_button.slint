import { Theme }             from "../theme.slint";

export component MotorButton inherits Rectangle {
    in-out property <bool> running;
    in property <bool> enabled: true;
    in property <string> motor-name: "Motor";
    callback clicked;

    height: 44px;
    width: 160px;
    border-radius: 6px;
    clip: true;

    background: !enabled ? Theme.surface_dim
                : running ? Theme.accent
                : Theme.accent_green;
    opacity: enabled ? 1.0 : 0.4;

    // Hover / press efekti
    states [
        pressed when ta.pressed && enabled : {
            root.background: running ? Theme.accent.darker(20%) : Theme.accent_green.darker(20%);
        }
        hovered when ta.has-hover && enabled : {
            root.background: running ? Theme.accent.darker(8%) : Theme.accent_green.darker(8%);
        }
    ]

    animate background { duration: 120ms; easing: ease-in-out; }
    animate opacity   { duration: 150ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        // Durum ikonu
        Text {
            text: running ? "■" : "▶";
            color: white;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: running ? "\{root.motor-name} DURDUR" : "\{root.motor-name} BAŞLAT";
            color: white;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}