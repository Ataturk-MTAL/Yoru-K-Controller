import { AppState } from "../state.slint";
import { AppTheme } from "../theme/theme.slint";

export component JoystickPanel {
    callback moved(float, float, float);   // dx, dy, max_radius
    callback released();

    min-height: 220px;

    // max-r outer-ring bazlı hesaplanıyor (outer-ring boyutu: min(parent)-20px)
    // Buraya outer-ring boyutunu yansıtan bir property ekliyoruz
    property <bool>  dragging: false;

    // Knob offset — merkeze göre piksel cinsinden (outer-ring relative)
    property <float> clamp-dx:  0;   // sola-sağa offset (piksel)
    property <float> clamp-dy:  0;   // yukarı-aşağı offset (piksel, yukarı pozitif)

    // Touch hesaplama ara değerleri
    property <float> raw-dx:    0;
    property <float> raw-dy:    0;
    property <float> dist:      0;
    property <float> factor:    1.0;

    Rectangle {
        background: AppTheme.surface;
        border-radius: AppTheme.radius-lg;

        VerticalLayout {
            padding: AppTheme.space-lg;
            spacing: AppTheme.space-md;

            Text {
                text: "SÜRÜŞ KUMANDA KOLU";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-xs;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            // Joystick alanı
            joystick-area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 180px;

                // Dış halka
                outer-ring := Rectangle {
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    width:  min(parent.width, parent.height) - 20px;
                    height: min(parent.width, parent.height) - 20px;
                    border-radius: self.width / 2;
                    border-width: 2px;

                    // max-r: outer-ring yarıçapı — knob merkezi daire içinde kalır, knob yarısı dışarı taşabilir
                    property <float> max-r: self.width / 2 / 1px;

                    states [
                        connected when AppState.connected: {
                            background: AppTheme.surface-sunken;
                            border-color: AppTheme.success.transparentize(50%);
                            in {
                                animate background { duration: AppTheme.anim-normal; }
                                animate border-color { duration: AppTheme.anim-normal; }
                            }
                        }
                        disconnected when !AppState.connected: {
                            background: AppTheme.surface-sunken;
                            border-color: AppTheme.border-default;
                            in {
                                animate background { duration: AppTheme.anim-normal; }
                                animate border-color { duration: AppTheme.anim-normal; }
                            }
                        }
                    ]

                    // ── Tolerans bantları (snap zone görseli) ────
                    // Dikey bant: düz ileri/geri snap alanı (%8 sağ + %8 sol = %16)
                    Rectangle {
                        x: parent.width * 0.42;
                        y: 0px;
                        width: parent.width * 0.16;
                        height: parent.height;
                        background: AppTheme.border-subtle;
                        opacity: 0.08;
                    }
                    // Yatay bant: saf dönüş snap alanı
                    Rectangle {
                        x: 0px;
                        y: parent.height * 0.42;
                        width: parent.width;
                        height: parent.height * 0.16;
                        background: AppTheme.border-subtle;
                        opacity: 0.08;
                    }

                    // ── + Kılavuz çizgileri ──────────────────────
                    // Yatay çizgi
                    Rectangle {
                        x: 0px;
                        y: parent.height / 2 - self.height / 2;
                        width: parent.width;
                        height: 2px;
                        background: AppTheme.border-default;
                        opacity: 0.4;
                    }
                    // Dikey çizgi
                    Rectangle {
                        x: parent.width / 2 - self.width / 2;
                        y: 0px;
                        width: 2px;
                        height: parent.height;
                        background: AppTheme.border-default;
                        opacity: 0.4;
                    }

                    // Merkez nokta
                    Rectangle {
                        x: parent.width / 2 - 4px;
                        y: parent.height / 2 - 4px;
                        width: 8px; height: 8px;
                        border-radius: 4px;
                        background: AppTheme.text-secondary;
                    }

                    // Joystick topu — pozisyon doğrudan clamp-dx/dy offset ile
                    knob := Rectangle {
                        x: parent.width / 2 + clamp-dx * 1px - self.width / 2;
                        y: parent.height / 2 - clamp-dy * 1px - self.height / 2;
                        width: 56px; height: 56px;
                        border-radius: self.width / 2;
                        border-width: 2px;

                        animate x { duration: dragging ? 0ms : 120ms; easing: ease-out; }
                        animate y { duration: dragging ? 0ms : 120ms; easing: ease-out; }

                        // Merkez ışığı
                        center-light := Rectangle {
                            x: parent.width / 2 - 6px;
                            y: parent.height / 2 - 6px;
                            width: 12px; height: 12px;
                            border-radius: 6px;
                        }

                        states [
                            drag-conn when dragging && AppState.connected: {
                                background: AppTheme.success;
                                border-color: AppTheme.success;
                                center-light.background: AppTheme.success;
                                in {
                                    animate background { duration: 80ms; }
                                    animate border-color { duration: 80ms; }
                                }
                            }
                            drag-disc when dragging && !AppState.connected: {
                                background: AppTheme.error;
                                border-color: AppTheme.text-tertiary;
                                center-light.background: AppTheme.text-tertiary;
                                in { animate background { duration: 80ms; } }
                            }
                            idle-motor when !dragging && AppState.connected && AppState.motor-running: {
                                background: AppTheme.success.transparentize(50%);
                                border-color: AppTheme.success;
                                center-light.background: AppTheme.success;
                                in {
                                    animate background { duration: AppTheme.anim-normal; }
                                    animate center-light.background { duration: AppTheme.anim-normal; }
                                }
                            }
                            idle-conn when !dragging && AppState.connected && !AppState.motor-running: {
                                background: AppTheme.success.transparentize(50%);
                                border-color: AppTheme.success;
                                center-light.background: AppTheme.text-tertiary;
                                in {
                                    animate background { duration: 120ms; }
                                    animate center-light.background { duration: AppTheme.anim-normal; }
                                }
                            }
                            idle-disc when !dragging && !AppState.connected: {
                                background: AppTheme.control-bg;
                                border-color: AppTheme.text-tertiary;
                                center-light.background: AppTheme.text-tertiary;
                                in {
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: AppTheme.anim-normal; }
                                }
                            }
                        ]
                    }

                    // Touch alanı
                    touch := TouchArea {
                        moved => {
                            dragging = true;

                            // mouse-x/y outer-ring içinde relative koordinat
                            raw-dx = touch.mouse-x / 1px - outer-ring.width / 2 / 1px;
                            raw-dy = outer-ring.height / 2 / 1px - touch.mouse-y / 1px;
                            dist   = sqrt(raw-dx * raw-dx + raw-dy * raw-dy);
                            factor = dist > outer-ring.max-r ? (outer-ring.max-r / dist) : 1.0;
                            clamp-dx = raw-dx * factor;
                            clamp-dy = raw-dy * factor;

                            root.moved(clamp-dx, clamp-dy, outer-ring.max-r);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                dragging  = false;
                                clamp-dx  = 0;
                                clamp-dy  = 0;
                                root.released();
                            }
                        }
                    }
                }
            }
        }
    }
}
