import { AppState } from "../state.slint";
import { Theme }    from "../theme.slint";

export component JoystickPanel {
    callback moved(float, float, float);   // dx, dy, max_radius
    callback released();

    min-height: 220px;

    // Hesaplama property'leri (root seviyesinde)
    property <float> cx:      self.width / 2 / 1px;
    property <float> cy:      self.height / 2 / 1px;
    property <float> max-r:   min(self.width, self.height) / 2 / 1px - 30;
    property <float> stick-x: cx;
    property <float> stick-y: cy;
    property <bool>  dragging: false;

    // Touch pozisyonundan hesaplanan ara değerler
    property <float> raw-dx:    0;
    property <float> raw-dy:    0;
    property <float> dist:      0;
    property <float> factor:    1.0;
    property <float> clamp-dx:  0;
    property <float> clamp-dy:  0;

    Rectangle {
        background: Theme.bg-card;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-xs;

            Text {
                text: "JOYSTICK";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                letter-spacing: 1.5px;
            }

            // Joystick alanı
            joystick-area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 180px;

                // Dış halka
                outer-ring := Rectangle {
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    width:  min(parent.width, parent.height) - 20px;
                    height: min(parent.width, parent.height) - 20px;
                    border-radius: self.width / 2;
                    border-width: 2px;

                    states [
                        connected when AppState.connected: {
                            background: #1a2a3a;
                            border-color: Theme.border-active;
                            in {
                                animate background { duration: 200ms; }
                                animate border-color { duration: 200ms; }
                            }
                        }
                        disconnected when !AppState.connected: {
                            background: #111111;
                            border-color: Theme.border;
                            in {
                                animate background { duration: 200ms; }
                                animate border-color { duration: 200ms; }
                            }
                        }
                    ]

                    // Eksen çizgisi yatay
                    Rectangle {
                        x: 0px; y: parent.height / 2 - 1px;
                        width: parent.width; height: 1px;
                        background: Theme.border;
                        opacity: 0.15;
                    }
                    // Eksen çizgisi dikey
                    Rectangle {
                        x: parent.width / 2 - 1px; y: 0px;
                        width: 1px; height: parent.height;
                        background: Theme.border;
                        opacity: 0.15;
                    }

                    // Merkez nokta
                    Rectangle {
                        x: parent.width / 2 - 3px;
                        y: parent.height / 2 - 3px;
                        width: 6px; height: 6px;
                        border-radius: 3px;
                        background: Theme.text-dim;
                    }

                    // Joystick topu
                    knob := Rectangle {
                        property <float> kx: stick-x - cx;
                        property <float> ky: stick-y - cy;

                        x: parent.width / 2 + kx * 1px - self.width / 2;
                        y: parent.height / 2 + ky * 1px - self.height / 2;
                        width: 56px; height: 56px;
                        border-radius: self.width / 2;
                        border-width: 2px;

                        animate x { duration: dragging ? 0ms : 120ms; easing: ease-out; }
                        animate y { duration: dragging ? 0ms : 120ms; easing: ease-out; }

                        // Merkez ışığı
                        center-light := Rectangle {
                            x: parent.width / 2 - 6px;
                            y: parent.height / 2 - 6px;
                            width: 12px; height: 12px;
                            border-radius: 6px;
                        }

                        states [
                            drag-conn when dragging && AppState.connected: {
                                background: Theme.accent-green;
                                border-color: Theme.accent-green;
                                center-light.background: Theme.accent-green;
                                in {
                                    animate background { duration: 80ms; }
                                    animate border-color { duration: 80ms; }
                                }
                            }
                            drag-disc when dragging && !AppState.connected: {
                                background: Theme.accent;
                                border-color: Theme.text-dim;
                                center-light.background: Theme.text-dim;
                                in { animate background { duration: 80ms; } }
                            }
                            idle-motor when !dragging && AppState.connected && AppState.motor-running: {
                                background: #2a6a4a;
                                border-color: Theme.accent-green;
                                center-light.background: Theme.accent-green;
                                in {
                                    animate background { duration: 200ms; }
                                    animate center-light.background { duration: 200ms; }
                                }
                            }
                            idle-conn when !dragging && AppState.connected && !AppState.motor-running: {
                                background: #2a6a4a;
                                border-color: Theme.accent-green;
                                center-light.background: Theme.text-dim;
                                in {
                                    animate background { duration: 120ms; }
                                    animate center-light.background { duration: 200ms; }
                                }
                            }
                            idle-disc when !dragging && !AppState.connected: {
                                background: Theme.bg-card;
                                border-color: Theme.text-dim;
                                center-light.background: Theme.text-dim;
                                in {
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 200ms; }
                                }
                            }
                        ]
                    }

                    // Touch alanı
                    touch := TouchArea {
                        moved => {
                            dragging = true;

                            // mouse-x/y outer-ring içinde relative koordinat
                            raw-dx = touch.mouse-x / 1px - parent.width / 2 / 1px;
                            raw-dy = parent.height / 2 / 1px - touch.mouse-y / 1px;
                            dist   = sqrt(raw-dx * raw-dx + raw-dy * raw-dy);
                            factor = dist > max-r ? (max-r / dist) : 1.0;
                            clamp-dx = raw-dx * factor;
                            clamp-dy = raw-dy * factor;

                            stick-x = cx + clamp-dx;
                            stick-y = cy - clamp-dy;

                            root.moved(clamp-dx, clamp-dy, max-r);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                dragging  = false;
                                stick-x   = cx;
                                stick-y   = cy;
                                clamp-dx  = 0;
                                clamp-dy  = 0;
                                root.released();
                            }
                        }
                    }
                }
            }

            // Klavye ipucu
            Text {
                text: "WASD / Ok tuşları  •  Space = DUR";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
            }
        }
    }
}
