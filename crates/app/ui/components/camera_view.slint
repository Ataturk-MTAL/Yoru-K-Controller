import { AppState }  from "../state.slint";
import { AppTheme }  from "../theme/theme.slint";
import { TBadge, BadgeVariant } from "../theme/components.slint";
import { ComboBox }  from "std-widgets.slint";

export component CameraView {
    callback start-camera(int);
    callback stop-camera();
    callback refresh-cameras();
    callback set-detection-enabled(bool);

    Rectangle {
        background: AppTheme.bg;

        // ── Kamera görüntüsü ─────────────────────────────
        if (AppState.camera-running): Image {
            source: AppState.camera-frame;
            image-fit: contain;
            width: parent.width;
            height: parent.height;
        }

        // ── Kamera kapalıysa yer tutucu ──────────────────
        if (!AppState.camera-running): VerticalLayout {
            alignment: center;
            spacing: AppTheme.space-xl;

            Text {
                text: "📷";
                font-size: 48px;
                horizontal-alignment: center;
                color: AppTheme.text-tertiary;
            }
            Text {
                text: "Kamera aktif değil";
                color: AppTheme.text-tertiary;
                font-size: AppTheme.font-lg;
                horizontal-alignment: center;
            }
            if (AppState.camera-error != ""): Text {
                text: AppState.camera-error;
                color: AppTheme.error;
                font-size: AppTheme.font-sm;
                horizontal-alignment: center;
            }
        }

        // ── Sağ üst: FPS + Tespit sayısı ─────────────────
        if (AppState.camera-running): HorizontalLayout {
            x: parent.width - self.width - 8px;
            y: 8px;
            spacing: AppTheme.space-sm;
            width: self.preferred-width;
            height: 22px;

            // FPS
            Rectangle {
                width: 72px;
                background: AppTheme.scrim;
                border-radius: AppTheme.radius-sm;
                Text {
                    text: "\{AppState.camera-fps} FPS";
                    color: AppState.camera-fps >= 20 ? AppTheme.success : AppTheme.warning;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Tespit sayısı (detection açıkken)
            if (AppState.detection-enabled): Rectangle {
                width: 72px;
                background: AppTheme.scrim;
                border-radius: AppTheme.radius-sm;
                Text {
                    text: "\{AppState.detection-count} nesne";
                    color: AppTheme.warning;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ── Kontrol çubuğu (sol alt) ─────────────────────
        Rectangle {
            y: parent.height - self.height - 8px;
            x: 8px;
            width: 380px;
            height: 32px;
            background: transparent;

            HorizontalLayout {
                spacing: AppTheme.space-sm;

                // Kamera seçici — sadece kamera duruyorken
                if (!AppState.camera-running): ComboBox {
                    horizontal-stretch: 1;
                    model: AppState.available-cameras;
                    current-index: AppState.camera-index;
                    selected(val) => {
                        AppState.camera-index = self.current-index;
                    }
                }

                // Yenile butonu
                if (!AppState.camera-running): Rectangle {
                    width: 28px;
                    background: AppTheme.control-bg;
                    border-radius: AppTheme.radius-md;
                    Text {
                        text: "↻";
                        color: AppTheme.text-primary;
                        font-size: AppTheme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh-cameras(); }
                    }
                }

                // Detection toggle (kamera çalışırken göster)
                if (AppState.camera-running): Rectangle {
                    width: 80px;
                    background: AppState.detection-enabled ? AppTheme.warning : AppTheme.control-bg;
                    border-radius: AppTheme.radius-md;
                    animate background { duration: AppTheme.anim-fast; }
                    Text {
                        text: AppState.detection-enabled ? "🔍 Kapat" : "🔍 Algıla";
                        color: AppState.detection-enabled ? AppTheme.text-inverse : AppTheme.text-primary;
                        font-size: AppTheme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.detection-enabled = !AppState.detection-enabled;
                            root.set-detection-enabled(AppState.detection-enabled);
                        }
                    }
                }

                // Başlat / Durdur
                Rectangle {
                    width: 80px;
                    background: AppState.camera-running ? AppTheme.error : AppTheme.success;
                    border-radius: AppTheme.radius-md;
                    animate background { duration: AppTheme.anim-fast; }
                    Text {
                        text: AppState.camera-running ? "■ Durdur" : "▶ Başlat";
                        color: black;
                        font-size: AppTheme.font-sm;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (AppState.camera-running) {
                                AppState.detection-enabled = false;
                                root.stop-camera();
                            } else {
                                AppState.camera-error = "";
                                root.start-camera(AppState.camera-index);
                            }
                        }
                    }
                }
            }
        }

        // ── Bağlantı durumu overlay (bağlı değilken uyarı) ──
        if (!AppState.connected): Rectangle {
            x: 8px; y: 8px;
            height: 24px;
            width: warning-text.preferred-width + 16px;
            background: AppTheme.error-subtle;
            border-radius: AppTheme.radius-sm;
            border-width: 1px;
            border-color: AppTheme.error.transparentize(60%);
            warning-text := Text {
                text: "Robot bağlı değil";
                color: AppTheme.error-text;
                font-size: AppTheme.font-sm;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 8px;
            }
        }
    }
}
