import { AppState }                            from "../state.slint";
import { AppTheme }                            from "../theme/theme.slint";
import { TStatusDot, StatusLevel }             from "../theme/components.slint";
import { ComboBox, LineEdit, Button, SpinBox } from "std-widgets.slint";

export component ConnectionPanel {
    callback connect-serial(string, int);
    callback connect-tcp(string, int);
    callback disconnect();
    callback refresh-ports();
    callback validate-host(string);

    VerticalLayout {
        spacing: AppTheme.space-md;

        // Başlık
        Text {
            text: "BAĞLANTI";
            color: AppTheme.text-secondary;
            font-size: AppTheme.font-xs;
            font-weight: 600;
            letter-spacing: 1.5px;
        }

        // ── Mod seçici ────────────────────────────────
        HorizontalLayout {
            spacing: AppTheme.space-sm;

            Rectangle {
                border-radius: AppTheme.radius-md;
                height: 30px;
                horizontal-stretch: 1;
                background: AppState.is-serial ? AppTheme.accent : AppTheme.control-bg;
                border-width: AppState.is-serial ? 0px : 1px;
                border-color: AppTheme.border-default;
                animate background { duration: AppTheme.anim-fast; }

                Text {
                    text: "Serial";
                    color: AppState.is-serial ? AppTheme.accent-text : AppTheme.text-secondary;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppState.is-serial = true; }
                }
            }

            Rectangle {
                border-radius: AppTheme.radius-md;
                height: 30px;
                horizontal-stretch: 1;
                background: !AppState.is-serial ? AppTheme.accent : AppTheme.control-bg;
                border-width: !AppState.is-serial ? 0px : 1px;
                border-color: AppTheme.border-default;
                animate background { duration: AppTheme.anim-fast; }

                Text {
                    text: "TCP/IP";
                    color: !AppState.is-serial ? AppTheme.accent-text : AppTheme.text-secondary;
                    font-size: AppTheme.font-sm;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppState.is-serial = false; }
                }
            }
        }

        // ── Serial: Port seçici ────────────────────────
        if (AppState.is-serial): HorizontalLayout {
            spacing: AppTheme.space-sm;

            Text {
                text: "Port:";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
                width: 34px;
            }

            ComboBox {
                horizontal-stretch: 1;
                model: AppState.available-ports;
                current-value: AppState.serial-port;
                selected(val) => { AppState.serial-port = val; }
            }

            Button {
                text: "↻";
                width: 30px;
                clicked => { root.refresh-ports(); }
            }
        }

        // ── TCP: Host ve Port yan yana ───────────────────
        if (!AppState.is-serial): HorizontalLayout {
            spacing: AppTheme.space-sm;
            alignment: stretch;

            Rectangle {
                horizontal-stretch: 1;
                preferred-width: 15 * 8.5px + 15px;
                border-radius: AppTheme.radius-md;
                border-width: !AppState.is-serial && AppState.tcp-host != "" ? 1.5px : 0px;
                border-color: AppState.tcp-host-valid ? AppTheme.success : AppTheme.error;
                clip: true;

                LineEdit {
                    width: 100%; height: 100%;
                    text <=> AppState.tcp-host;
                    font-family: "Space Mono";
                    placeholder-text: "192.168.4.1";

                    key-pressed(event) => {
                        // Rakam ve noktaya izin ver
                        if (event.text >= "0" && event.text <= "9") || event.text == "." {
                            return reject;
                        }
                        // Kontrol tuşlarına izin ver
                        if event.text == Key.Backspace || event.text == Key.Delete
                           || event.text == Key.LeftArrow || event.text == Key.RightArrow
                           || event.text == Key.Home || event.text == Key.End
                           || event.text == Key.Tab {
                            return reject;
                        }
                        // Diğer her şeyi engelle
                        return accept;
                    }

                    edited(text) => {
                        root.validate-host(text);
                    }
                }
            }

            Text {
                text: ":";
                color: AppTheme.text-secondary;
                font-size: AppTheme.font-md;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            SpinBox {
                minimum: 1;
                maximum: 65535;
                preferred-width: 5 * 8.5px+ 5px; 
                value <=> AppState.tcp-port;
                horizontal-stretch: 2;
            }
        }

        // ── Bağlan / Kes ───────────────────────────────
        Button {
            text: AppState.connected ? "BAĞLANTIYI KES" : "BAĞLAN";
            primary: !AppState.connected;
            enabled: AppState.connected || AppState.is-serial || AppState.tcp-host-valid;
            clicked => {
                if (AppState.connected) {
                    root.disconnect();
                } else if (AppState.is-serial) {
                    root.connect-serial(AppState.serial-port, AppState.baud-rate);
                } else {
                    root.connect-tcp(AppState.tcp-host, AppState.tcp-port);
                }
            }
        }

        // ── Durum indikatörü ───────────────────────────
        HorizontalLayout {
            spacing: AppTheme.space-md;
            alignment: center;

            TStatusDot {
                status: AppState.connected ? StatusLevel.online : StatusLevel.idle;
            }

            Text {
                text: AppState.connected
                    ? (AppState.is-serial ? "Seri Port" : "TCP/IP") + " — Bağlı"
                    : "Bağlantı yok";
                color: AppState.connected ? AppTheme.success : AppTheme.text-tertiary;
                font-size: AppTheme.font-sm;
                vertical-alignment: center;
            }
        }
    }
}
