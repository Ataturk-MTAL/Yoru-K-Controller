import { AppState }  from "../state.slint";
import { Theme }     from "../theme.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";

export component ConnectionPanel {
    callback connect-serial(string, int);
    callback connect-tcp(string, int);
    callback disconnect();
    callback refresh-ports();

    // TCP: local string properties for TextInput binding
    property <string> tcp-host-text: AppState.tcp-host;
    property <string> tcp-port-text: AppState.tcp-port;

    Rectangle {
        background: Theme.bg-card;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-xs;

            // Başlık
            Text {
                text: "BAĞLANTI";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                letter-spacing: 1.5px;
            }

            // ── Mod seçici ────────────────────────────────
            HorizontalLayout {
                spacing: Theme.pad-xs;

                Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;
                    background: AppState.is-serial ? Theme.accent : Theme.bg-panel;
                    animate background { duration: 150ms; }

                    Text {
                        text: "Serial";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { AppState.is-serial = true; }
                    }
                }

                Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;
                    background: !AppState.is-serial ? Theme.accent : Theme.bg-panel;
                    animate background { duration: 150ms; }

                    Text {
                        text: "TCP/IP";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { AppState.is-serial = false; }
                    }
                }
            }

            // ── Serial ayarları ────────────────────────────
            if (AppState.is-serial): HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                Text {
                    text: "Port:";
                    color: Theme.text-dim;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    width: 34px;
                }

                ComboBox {
                    horizontal-stretch: 1;
                    model: AppState.available-ports;
                    current-value: AppState.serial-port;
                    selected(val) => {
                        AppState.serial-port = val;
                    }
                }

                // Yenile butonu
                Rectangle {
                    background: Theme.bg-panel;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    width: 26px; height: 26px;

                    Text {
                        text: "↻";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.refresh-ports(); }
                    }
                }
            }

            // ── TCP ayarları ───────────────────────────────
            if (!AppState.is-serial): VerticalLayout {
                spacing: Theme.pad-xs;

                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Host:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> tcp-host-text;
                        edited(val) => { AppState.tcp-host = val; }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Port:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> tcp-port-text;
                        input-type: number;
                    }
                }
            }

            // ── Bağlan / Kes butonu ────────────────────────
            Rectangle {
                border-radius: Theme.radius;
                height: 32px;
                background: AppState.connected ? Theme.accent : Theme.accent-green;
                animate background { duration: 300ms; }

                Text {
                    text: AppState.connected ? "BAĞLANTIYI KES" : "BAĞLAN";
                    color: white;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (AppState.connected) {
                            root.disconnect();
                        } else if (AppState.is-serial) {
                            root.connect-serial(AppState.serial-port, AppState.baud-rate);
                        } else {
                            root.connect-tcp(
                                tcp-host-text,
                                round(tcp-port-text.to-float())
                            );
                        }
                    }
                }
            }

            // ── Durum indikatörü ───────────────────────────
            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                Rectangle {
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    background: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    animate background { duration: 200ms; }
                }

                Text {
                    text: AppState.connected
                        ? (AppState.is-serial ? "Seri Port" : "TCP/IP") + " — Bağlı"
                        : "Bağlantı yok";
                    color: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
