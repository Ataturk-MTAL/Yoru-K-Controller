import { AppState } from "../state.slint";
import { Theme }    from "../theme.slint";

export component ConnectionPanel {
    callback connect-serial(string, int);   // port, baud
    callback connect-tcp(string, int);      // host, port
    callback disconnect();
    callback refresh-ports();

    // Dropdown durumu
    property <bool> port-dropdown-open: false;
    // TCP: TextInput string olarak tutar, bağlanınca parse edilir
    property <string> tcp-host-text: AppState.tcp-host;
    property <string> tcp-port-text: AppState.tcp-port;

    // Dış container — clip: false ki dropdown taşsın
    outer := Rectangle {
        background: Theme.bg-card;
        border-radius: Theme.radius;
        clip: false;

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-xs;

            // Başlık
            Text {
                text: "BAĞLANTI";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                letter-spacing: 1.5px;
            }

            // ── Mod seçici ────────────────────────────────
            HorizontalLayout {
                spacing: Theme.pad-xs;

                Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;
                    background: AppState.is-serial ? Theme.accent : Theme.bg-panel;
                    animate background { duration: 150ms; }

                    Text {
                        text: "Serial";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            AppState.is-serial = true;
                            port-dropdown-open = false;
                        }
                    }
                }

                Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;
                    background: !AppState.is-serial ? Theme.accent : Theme.bg-panel;
                    animate background { duration: 150ms; }

                    Text {
                        text: "TCP/IP";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            AppState.is-serial = false;
                            port-dropdown-open = false;
                        }
                    }
                }
            }

            // ── Serial ayarları ────────────────────────────
            if (AppState.is-serial): HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                Text {
                    text: "Port:";
                    color: Theme.text-dim;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    width: 34px;
                }

                // Port seçici butonu
                port-selector := Rectangle {
                    background: Theme.bg-panel;
                    border-color: port-dropdown-open ? Theme.border-active : Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    height: 26px;
                    horizontal-stretch: 1;
                    animate border-color { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: Theme.pad-xs;
                        padding-right: 4px;
                        alignment: center;

                        Text {
                            text: AppState.serial-port == ""
                                ? "Port seçin..." : AppState.serial-port;
                            color: AppState.serial-port == ""
                                ? Theme.text-dim : Theme.text-primary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: port-dropdown-open ? "▲" : "▼";
                            color: Theme.text-dim;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            port-dropdown-open = !port-dropdown-open;
                            if (port-dropdown-open) { root.refresh-ports(); }
                        }
                    }
                }

                // Yenile butonu
                Rectangle {
                    background: Theme.bg-panel;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    width: 26px; height: 26px;

                    Text {
                        text: "↻";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.refresh-ports();
                            port-dropdown-open = true;
                        }
                    }
                }
            }

            // ── TCP ayarları ───────────────────────────────
            if (!AppState.is-serial): VerticalLayout {
                spacing: Theme.pad-xs;

                // Host
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Host:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    host-rect := Rectangle {
                        background: Theme.bg-panel;
                        border-color: host-input.has-focus ? Theme.border-active : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        height: 26px;
                        horizontal-stretch: 1;
                        animate border-color { duration: 100ms; }

                        host-input := TextInput {
                            text <=> tcp-host-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            height: parent.height;
                            x: Theme.pad-xs;
                            width: parent.width - Theme.pad-xs * 2;
                            single-line: true;
                            edited => { AppState.tcp-host = self.text; }
                        }
                    }
                }

                // Port
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Port:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    port-rect := Rectangle {
                        background: Theme.bg-panel;
                        border-color: port-input.has-focus ? Theme.border-active : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        height: 26px;
                        horizontal-stretch: 1;
                        animate border-color { duration: 100ms; }

                        port-input := TextInput {
                            text <=> tcp-port-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            height: parent.height;
                            x: Theme.pad-xs;
                            width: parent.width - Theme.pad-xs * 2;
                            single-line: true;
                            input-type: number;
                        }
                    }
                }
            }

            // ── Bağlan / Kes butonu ────────────────────────
            Rectangle {
                border-radius: Theme.radius;
                height: 32px;
                background: AppState.connected ? Theme.accent : Theme.accent-green;
                animate background { duration: 300ms; }

                Text {
                    text: AppState.connected ? "BAĞLANTIYI KES" : "BAĞLAN";
                    color: white;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (AppState.connected) {
                            root.disconnect();
                        } else if (AppState.is-serial) {
                            root.connect-serial(AppState.serial-port, AppState.baud-rate);
                        } else {
                            root.connect-tcp(
                                tcp-host-text,
                                round(tcp-port-text.to-float())
                            );
                        }
                    }
                }
            }

            // ── Durum indikatörü ───────────────────────────
            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                Rectangle {
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    background: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    animate background { duration: 200ms; }
                }

                Text {
                    text: AppState.connected
                        ? (AppState.is-serial ? "Seri Port" : "TCP/IP") + " — Bağlı"
                        : "Bağlantı yok";
                    color: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
        }

        // ── Port dropdown OVERLAY ──────────────────────────
        // VerticalLayout dışında, absolute konumlu → layout'u itmez
        if (port-dropdown-open && AppState.is-serial): Rectangle {
            // port-selector'ın altına hizala (başlık+mod+port-row yüksekliği ≈ 90px)
            y: 90px;
            x: Theme.pad-sm + 34px + Theme.pad-xs;  // "Port:" label genişliği + spacing
            width: outer.width - Theme.pad-sm - (34px + Theme.pad-xs) - 26px - Theme.pad-xs - Theme.pad-sm;
            height: AppState.available-ports.length == 0 ? 34px
                : min(AppState.available-ports.length * 28px, 148px);
            background: #0d2040;
            border-color: Theme.border-active;
            border-width: 1px;
            border-radius: Theme.radius;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000088;

            // Port yok mesajı
            if (AppState.available-ports.length == 0): Text {
                text: "Port bulunamadı";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Port listesi
            if (AppState.available-ports.length > 0): VerticalLayout {
                for port in AppState.available-ports: port-item := Rectangle {
                    height: 28px;
                    background: AppState.serial-port == port ? #1a4a80 : transparent;
                    animate background { duration: 80ms; }

                    Text {
                        text: port;
                        color: AppState.serial-port == port
                            ? Theme.text-primary : #aaaaaa;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        x: Theme.pad-sm;
                    }
                    TouchArea {
                        clicked => {
                            AppState.serial-port = port;
                            port-dropdown-open = false;
                        }
                    }
                }
            }
        }
    }
}
