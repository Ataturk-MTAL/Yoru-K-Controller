import { AppState } from "../state.slint";
import { Theme }    from "../theme.slint";

export component ConnectionPanel {
    callback connect-serial(string, int);   // port, baud
    callback connect-tcp(string, int);      // host, port
    callback disconnect();
    callback refresh-ports();

    // Port dropdown açık mı?
    property <bool> port-dropdown-open: false;
    // TCP host düzenleme
    property <string> tcp-host-edit: AppState.tcp-host;

    Rectangle {
        background: Theme.bg-card;
        border-radius: Theme.radius;
        clip: false;

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-xs;

            // Başlık
            Text {
                text: "BAĞLANTI";
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                letter-spacing: 1.5px;
            }

            // Mod seçici
            HorizontalLayout {
                spacing: Theme.pad-xs;

                serial-btn := Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Serial";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            AppState.is-serial = true;
                            port-dropdown-open = false;
                        }
                    }

                    states [
                        active when AppState.is-serial: {
                            background: Theme.accent;
                            in { animate background { duration: 150ms; } }
                        }
                        inactive when !AppState.is-serial: {
                            background: Theme.bg-panel;
                            in { animate background { duration: 150ms; } }
                        }
                    ]
                }

                tcp-btn := Rectangle {
                    border-radius: Theme.radius;
                    height: 28px;
                    horizontal-stretch: 1;

                    Text {
                        text: "TCP/IP";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            AppState.is-serial = false;
                            port-dropdown-open = false;
                        }
                    }

                    states [
                        active when !AppState.is-serial: {
                            background: Theme.accent;
                            in { animate background { duration: 150ms; } }
                        }
                        inactive when AppState.is-serial: {
                            background: Theme.bg-panel;
                            in { animate background { duration: 150ms; } }
                        }
                    ]
                }
            }

            // ── Serial ayarları ────────────────────────────
            if (AppState.is-serial): VerticalLayout {
                spacing: Theme.pad-xs;

                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Port:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    // Port seçici — tıklayınca dropdown açılır
                    port-selector := Rectangle {
                        background: Theme.bg-panel;
                        border-color: port-dropdown-open ? Theme.border-active : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        height: 26px;
                        horizontal-stretch: 1;
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: Theme.pad-xs;
                            padding-right: 4px;
                            alignment: center;

                            Text {
                                text: AppState.serial-port == ""
                                    ? "Port seçin..." : AppState.serial-port;
                                color: AppState.serial-port == ""
                                    ? Theme.text-disabled : Theme.text-primary;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: port-dropdown-open ? "▲" : "▼";
                                color: Theme.text-dim;
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                port-dropdown-open = !port-dropdown-open;
                                if (port-dropdown-open) { root.refresh-ports(); }
                            }
                        }
                    }

                    // Yenile butonu
                    refresh-btn := Rectangle {
                        background: Theme.bg-panel;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        width: 26px; height: 26px;

                        Text {
                            text: "↻";
                            color: Theme.text-primary;
                            font-size: Theme.font-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.refresh-ports();
                                port-dropdown-open = true;
                            }
                        }
                    }
                }

                // Port dropdown listesi
                if (port-dropdown-open): Rectangle {
                    background: Theme.bg-panel;
                    border-color: Theme.border-active;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    // Dinamik yükseklik: max 5 port × 28px
                    height: AppState.available-ports.length == 0 ? 32px
                        : min(AppState.available-ports.length * 28px, 140px);

                    // Port yok mesajı
                    if (AppState.available-ports.length == 0): Text {
                        text: "Port bulunamadı";
                        color: Theme.text-disabled;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Port listesi
                    if (AppState.available-ports.length > 0): VerticalLayout {
                        for port in AppState.available-ports: port-item := Rectangle {
                            height: 28px;
                            background: AppState.serial-port == port
                                ? Theme.bg-card-hover : transparent;
                            animate background { duration: 80ms; }

                            Text {
                                text: port;
                                color: AppState.serial-port == port
                                    ? Theme.text-primary : Theme.text-dim;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                                x: Theme.pad-sm;
                            }
                            TouchArea {
                                clicked => {
                                    AppState.serial-port = port;
                                    port-dropdown-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // ── TCP ayarları ───────────────────────────────
            if (!AppState.is-serial): VerticalLayout {
                spacing: Theme.pad-xs;

                // Host satırı
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Host:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    // Düzenlenebilir host input
                    host-rect := Rectangle {
                        background: Theme.bg-panel;
                        border-color: host-input.has-focus ? Theme.border-active : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        height: 26px;
                        horizontal-stretch: 1;
                        animate border-color { duration: 100ms; }

                        host-input := TextInput {
                            text: AppState.tcp-host;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            x: Theme.pad-xs;
                            width: parent.width - Theme.pad-xs * 2;
                            single-line: true;
                            edited => { AppState.tcp-host = self.text; }
                        }
                    }
                }

                // Port satırı
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: center;

                    Text {
                        text: "Port:";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    port-rect := Rectangle {
                        background: Theme.bg-panel;
                        border-color: port-input.has-focus ? Theme.border-active : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        height: 26px;
                        horizontal-stretch: 1;
                        animate border-color { duration: 100ms; }

                        port-input := TextInput {
                            text: AppState.tcp-port;
                            color: Theme.text-primary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            x: Theme.pad-xs;
                            width: parent.width - Theme.pad-xs * 2;
                            single-line: true;
                            input-type: number;
                            edited => {
                                if (self.text.to-float() > 0) {
                                    AppState.tcp-port = round(self.text.to-float());
                                }
                            }
                        }
                    }
                }
            }

            // ── Bağlan / Kes butonu ────────────────────────
            connect-rect := Rectangle {
                border-radius: Theme.radius;
                height: 32px;

                Text {
                    text: AppState.connected ? "BAĞLANTIYI KES" : "BAĞLAN";
                    color: white;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                states [
                    connected when AppState.connected: {
                        background: Theme.accent;
                        in { animate background { duration: 300ms; } }
                    }
                    disconnected when !AppState.connected: {
                        background: Theme.accent-green;
                        in { animate background { duration: 300ms; } }
                    }
                ]

                TouchArea {
                    clicked => {
                        if (AppState.connected) {
                            root.disconnect();
                        } else if (AppState.is-serial) {
                            root.connect-serial(AppState.serial-port, AppState.baud-rate);
                        } else {
                            root.connect-tcp(AppState.tcp-host, AppState.tcp-port);
                        }
                    }
                }
            }

            // Durum indikatörü
            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                Rectangle {
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    background: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    animate background { duration: 200ms; }
                }

                Text {
                    text: AppState.connected
                        ? (AppState.is-serial ? "Seri Port" : "TCP/IP") + " — Bağlı"
                        : "Bağlantı yok";
                    color: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
