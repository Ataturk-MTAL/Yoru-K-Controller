import "./assets/fonts/Saira-Regular.ttf";
import "./assets/fonts/Saira-Medium.ttf";
import "./assets/fonts/Saira-SemiBold.ttf";
import "./assets/fonts/SpaceMono-Bold.ttf";

import { AppState }        from "state.slint";
import { AppTheme }        from "theme/theme.slint";
import {
    TCard,
    TBadge,
    TStatusDot,
    TSeparator,
    ThemeToggle,
    BadgeVariant,
    StatusLevel,
}
                           from "theme/components.slint";
import { ConnectionPanel } from "components/connection_panel.slint";
import { MotorControl }    from "components/motor_control.slint";
import { JoystickPanel }   from "components/joystick_panel.slint";
import { SpeedDisplay }    from "components/speed_display.slint";
import { CameraView }      from "components/camera_view.slint";
import { MapView }         from "components/map_view.slint";
import { Palette, StandardButton, Button } from "std-widgets.slint";

export { AppState }

export component AppWindow inherits Window {
    title: "Yörü-K Kontrolcü";
    default-font-family: "Saira";
    default-font-weight: 600;
    background: AppTheme.bg;
    min-width: 1024px;
    min-height: 860px;
    preferred-width: 1280px;
    preferred-height: 960px;

    // ── Rust'a callback'ler ──────────────────────────────
    callback connect-serial(string, int);
    callback connect-tcp(string, int);
    callback disconnect();
    callback refresh-ports();
    callback validate-host(string);
    callback send-start();
    callback send-stop();
    callback send-light(bool);
    callback send-brake(bool);
    callback set-gear(int);
    callback set-reverse-left(bool);
    callback set-reverse-right(bool);
    callback joystick-moved(float, float, float);
    callback joystick-released();
    callback start-camera(int);
    callback stop-camera();
    callback refresh-cameras();
    callback enable-gps();
    callback disable-gps();
    callback set-detection-enabled(bool);
    callback map-flicked(length, length);
    callback map-zoom-changed(int);
    callback map-zoom-in(length, length);
    callback map-zoom-out(length, length);
    callback show-about();

    // Rust → Slint: harita viewport'unu ayarla (zoom değiştiğinde)
    public function set-map-viewport(ox: length, oy: length, w: length, h: length) {
        map-view.set-viewport(ox, oy, w, h);
    }

    // Rust → Slint: harita viewport boyutunu oku
    out property <length> map-visible-width:  map-view.visible-width;
    out property <length> map-visible-height: map-view.visible-height;

    // Dark tema zorla
    init => {
        Palette.color-scheme = ColorScheme.dark;
        AppState.is-dark = true;
    }

    // Dialog görünürlükleri
    property <bool> help-visible: false;
    // in property <image> app_icon: @image-url("./assets/Yörü-K-1.svg");

    icon: @image-url("./assets/Yörü-K-1.svg");

    // ── MenuBar (macOS: sistem menü çubuğu) ─────────────
    MenuBar {
        Menu {
            title: "Bağlantı";
            MenuItem {
                title: "Bağlantıyı Kes";
                activated => {
                    root.disconnect();
                }
            }
        }

        Menu {
            title: "Görünüm";
            MenuItem {
                title: "Kamera";
                activated => {
                    AppState.active-tab = 0;
                }
            }

            MenuItem {
                title: "Harita";
                activated => {
                    AppState.active-tab = 1;
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Tema Değiştir";
                activated => {
                    if (AppTheme.dark) {
                        Palette.color-scheme = ColorScheme.light;
                        AppState.is-dark = false;
                    } else {
                        Palette.color-scheme = ColorScheme.dark;
                        AppState.is-dark = true;
                    }
                }
            }
        }

        Menu {
            title: "Yardım";
            MenuItem {
                title: "Klavye Kısayolları";
                activated => {
                    root.help-visible = !root.help-visible;
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Hakkında";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    // ── Klavye focus ─────────────────────────────────────
    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(e) => {
            if (e.text == " ") {
                root.send-stop();
                return accept;
            }
            if (e.text == "1") {
                root.set-gear(1);
                return accept;
            }
            if (e.text == "2") {
                root.set-gear(2);
                return accept;
            }
            if (e.text == "3") {
                root.set-gear(3);
                return accept;
            }
            if (e.text == "l") {
                root.send-light(!AppState.light-on);
                return accept;
            }
            if (e.text == "b") {
                root.send-brake(!AppState.brake-on);
                return accept;
            }
            if (e.text == "m") {
                AppState.active-tab = 1;
                return accept;
            }
            if (e.text == "c") {
                AppState.active-tab = 0;
                return accept;
            }
            if (e.text == "t") {
                if (AppTheme.dark) {
                    Palette.color-scheme = ColorScheme.light;
                    AppState.is-dark = false;
                } else {
                    Palette.color-scheme = ColorScheme.dark;
                    AppState.is-dark = true;
                }
                return accept;
            }
            if (e.text == "w" || e.text == Key.UpArrow) {
                return accept;
            }
            if (e.text == "s" || e.text == Key.DownArrow) {
                return accept;
            }
            if (e.text == "a" || e.text == Key.LeftArrow) {
                return accept;
            }
            if (e.text == "d" || e.text == Key.RightArrow) {
                return accept;
            }
            reject
        }
        key-released(e) => {
            if (e.text == "w" || e.text == Key.UpArrow) {
                return accept;
            }
            if (e.text == "s" || e.text == Key.DownArrow) {
                return accept;
            }
            if (e.text == "a" || e.text == Key.LeftArrow) {
                return accept;
            }
            if (e.text == "d" || e.text == Key.RightArrow) {
                return accept;
            }
            reject
        }

        // ── Ana layout ───────────────────────────────────
        VerticalLayout {
            spacing: 0px;

            // ══════════ ÜST TOOLBAR ══════════════════════
            Rectangle {
                height: 40px;
                background: AppTheme.surface;

                // Alt çizgi
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: AppTheme.border-subtle;
                }

                HorizontalLayout {
                    padding-left: AppTheme.space-xl;
                    padding-right: AppTheme.space-xl;

                    Text {
                        text: "YÖRÜ-K";
                        color: AppTheme.text-primary;
                        font-size: AppTheme.font-lg;
                        font-weight: 700;
                        vertical-alignment: center;
                        letter-spacing: 2px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // ── Sekme butonları ──
                    Rectangle {
                        width: 96px;
                        background: AppState.active-tab == 0 ? AppTheme.accent-subtle : transparent;
                        border-radius: AppTheme.radius-md;
                        animate background { duration: AppTheme.anim-fast; }

                        Text {
                            text: "📷 Kamera";
                            color: AppState.active-tab == 0 ? AppTheme.accent : AppTheme.text-secondary;
                            font-size: AppTheme.font-sm;
                            font-weight: AppState.active-tab == 0 ? 600 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppState.active-tab = 0;
                            }
                        }
                    }

                    Rectangle {
                        width: AppTheme.space-sm;
                    }

                    Rectangle {
                        width: 96px;
                        background: AppState.active-tab == 1 ? AppTheme.accent-subtle : transparent;
                        border-radius: AppTheme.radius-md;
                        animate background { duration: AppTheme.anim-fast; }

                        Text {
                            text: "🛰 Harita";
                            color: AppState.active-tab == 1 ? AppTheme.accent : AppTheme.text-secondary;
                            font-size: AppTheme.font-sm;
                            font-weight: AppState.active-tab == 1 ? 600 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppState.active-tab = 1;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // ── Tema geçiş düğmesi ──
                    ThemeToggle { }
                }
            }

            // ══════════ ANA İÇERİK ══════════════════════
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // ── SOL PANEL: Kamera / Harita ──
                Rectangle {
                    horizontal-stretch: 1;
                    background: AppTheme.bg;

                    CameraView {
                        visible: AppState.active-tab == 0;
                        width: parent.width;
                        height: parent.height;
                        start-camera(i) => {
                            root.start-camera(i);
                        }
                        stop-camera() => {
                            root.stop-camera();
                        }
                        refresh-cameras() => {
                            root.refresh-cameras();
                        }
                        set-detection-enabled(v) => {
                            root.set-detection-enabled(v);
                        }
                    }

                    map-view := MapView {
                        visible: AppState.active-tab == 1;
                        width: parent.width;
                        height: parent.height;
                        enable-gps() => {
                            root.enable-gps();
                        }
                        disable-gps() => {
                            root.disable-gps();
                        }
                        map-flicked(ox, oy) => {
                            root.map-flicked(ox, oy);
                        }
                        map-zoom-changed(z) => {
                            root.map-zoom-changed(z);
                        }
                        map-zoom-in(mx, my) => {
                            root.map-zoom-in(mx, my);
                        }
                        map-zoom-out(mx, my) => {
                            root.map-zoom-out(mx, my);
                        }
                    }
                }

                // ── SAĞ PANEL: Kontrol ──
                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-secondary;

                    // Sol kenarlık
                    Rectangle {
                        x: 0;
                        width: 1px;
                        height: parent.height;
                        background: AppTheme.border-subtle;
                    }

                    VerticalLayout {
                        padding: AppTheme.space-lg;
                        spacing: AppTheme.space-lg;

                        ConnectionPanel {
                            connect-serial(p, b) => {
                                root.connect-serial(p, b);
                            }
                            connect-tcp(h, p) => {
                                root.connect-tcp(h, p);
                            }
                            disconnect() => {
                                root.disconnect();
                            }
                            refresh-ports() => {
                                root.refresh-ports();
                            }
                            validate-host(h) => {
                                root.validate-host(h);
                            }
                        }

                        TSeparator { }

                        MotorControl {
                            start() => {
                                root.send-start();
                            }
                            stop() => {
                                root.send-stop();
                            }
                            set-gear(g) => {
                                root.set-gear(g);
                            }
                            set-light(v) => {
                                root.send-light(v);
                            }
                            set-brake(v) => {
                                root.send-brake(v);
                            }
                            set-reverse-l(v) => {
                                root.set-reverse-left(v);
                            }
                            set-reverse-r(v) => {
                                root.set-reverse-right(v);
                            }
                        }

                        TSeparator { }

                        JoystickPanel {
                            moved(dx, dy, r) => {
                                root.joystick-moved(dx, dy, r);
                            }
                            released() => {
                                root.joystick-released();
                            }
                        }

                        SpeedDisplay {
                            vertical-stretch: 1;
                        }
                    }
                }
            }

            // ══════════ ALT STATUS BAR ═══════════════════
            Rectangle {
                height: 26px;
                background: AppTheme.surface;

                // Üst çizgi
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: AppTheme.border-subtle;
                }

                HorizontalLayout {
                    padding-left: AppTheme.space-xl;
                    padding-right: AppTheme.space-xl;
                    padding-top: AppTheme.space-sm;
                    padding-bottom: AppTheme.space-sm;
                    spacing: AppTheme.space-xl;

                    // Bağlantı durumu
                    HorizontalLayout {
                        spacing: AppTheme.space-md;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: AppState.connected ? AppTheme.sensor-online : AppTheme.sensor-offline;
                            animate background { duration: AppTheme.anim-normal; }
                        }

                        Text {
                            text: AppState.connected ? (AppState.is-serial ? "Serial" : "TCP/IP") + " — Bağlı" : "Bağlantı yok";
                            color: AppState.connected ? AppTheme.success-text : AppTheme.text-tertiary;
                            font-size: AppTheme.font-xs;
                            vertical-alignment: center;
                        }
                    }

                    // Ayırıcı
                    Rectangle {
                        width: 1px;
                        background: AppTheme.border-subtle;
                    }

                    // Motor durumu
                    HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: AppState.motor-running ? AppTheme.motor-running : AppTheme.motor-stopped;
                            animate background { duration: AppTheme.anim-normal; }
                        }

                        Text {
                            text: AppState.motor-running ? "Motor Çalışıyor" : "Motor Durdu";
                            color: AppState.motor-running ? AppTheme.success-text : AppTheme.text-tertiary;
                            font-size: AppTheme.font-xs;
                            vertical-alignment: center;
                        }

                        if (AppState.motor-running): Text {
                            text: "V\{AppState.gear}";
                            color: AppTheme.warning-text;
                            font-size: AppTheme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // Ayırıcı
                    Rectangle {
                        width: 1px;
                        background: AppTheme.border-subtle;
                    }

                    // Periferal durumu
                    if (AppState.light-on): HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppTheme.warning;
                        }

                        Text {
                            text: "Işık";
                            color: AppTheme.warning-text;
                            font-size: AppTheme.font-xs;
                            vertical-alignment: center;
                        }
                    }

                    if (AppState.brake-on): HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppTheme.error;
                        }

                        Text {
                            text: "Fren";
                            color: AppTheme.error-text;
                            font-size: AppTheme.font-xs;
                            vertical-alignment: center;
                        }
                    }

                    // GPS durumu
                    if (AppState.gps-active): HorizontalLayout {
                        spacing: AppTheme.space-sm;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppState.gps-point-count > 0 ? AppTheme.sensor-online : AppTheme.sensor-warning;
                            animate background { duration: AppTheme.anim-normal; }
                        }

                        Text {
                            text: AppState.gps-point-count > 0 ? round(AppState.gps-lat * 10000) / 10000 + "°  " + round(AppState.gps-lon * 10000) / 10000 + "°" : "GPS bekliyor...";
                            color: AppState.gps-point-count > 0 ? AppTheme.success-text : AppTheme.warning-text;
                            font-size: AppTheme.font-xs;
                            vertical-alignment: center;
                        }
                    }

                    // Sağa itmek için boşluk
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Kamera FPS (sağda)
                    if (AppState.camera-running): Text {
                        text: "\{AppState.camera-fps} FPS";
                        color: AppState.camera-fps >= 20 ? AppTheme.success-text : AppTheme.warning-text;
                        font-size: AppTheme.font-xs;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    // Detection sayısı
                    if (AppState.detection-enabled && AppState.camera-running): Text {
                        text: "\{AppState.detection-count} nesne";
                        color: AppTheme.info-text;
                        font-size: AppTheme.font-xs;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    // Durum mesajı
                    Text {
                        text: AppState.status-text;
                        color: AppTheme.text-tertiary;
                        font-size: AppTheme.font-xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── Yardım dialog overlay ────────────────────────────
    if (help-visible): Rectangle {
        background: AppTheme.scrim;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        Rectangle {
            width: 360px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: AppTheme.surface-raised;
            border-color: AppTheme.border-default;
            border-width: 1px;
            border-radius: AppTheme.radius-xl;
            drop-shadow-blur: 24px;
            drop-shadow-color: AppTheme.shadow;

            VerticalLayout {
                padding: AppTheme.space-xl;
                spacing: AppTheme.space-lg;

                HorizontalLayout {
                    Text {
                        text: "Klavye Kısayolları";
                        color: AppTheme.text-primary;
                        font-size: AppTheme.font-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: AppTheme.radius-full;
                        background: AppTheme.control-bg-hover;
                        Text {
                            text: "✕";
                            color: AppTheme.text-secondary;
                            font-size: AppTheme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.help-visible = false;
                            }
                        }
                    }
                }

                TSeparator { }

                for row in [
                    ["Space", "Acil durdurma"],
                    ["1 / 2 / 3", "Vites seç"],
                    ["L", "Işık aç/kapat"],
                    ["B", "Fren aç/kapat"],
                    ["C", "Kamera sekmesi"],
                    ["M", "Harita sekmesi"],
                    ["T", "Tema değiştir"],
                ]: HorizontalLayout {
                    spacing: AppTheme.space-md;
                    Rectangle {
                        width: 90px;
                        height: 24px;
                        background: AppTheme.surface-sunken;
                        border-radius: AppTheme.radius-sm;
                        Text {
                            text: row[0];
                            color: AppTheme.accent;
                            font-size: AppTheme.font-sm;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: row[1];
                        color: AppTheme.text-secondary;
                        font-size: AppTheme.font-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }

        TouchArea {
            clicked => {
                root.help-visible = false;
            }
        }
    }
}

// ── Hakkında Penceresi ───────────────────────────────
export component AboutWindow inherits Window {
    title: "Hakkında — Yörü-K";
    default-font-family: "Saira";
    default-font-weight: 600;
    background: AppTheme.bg;
    icon: @image-url("./assets/Yörü-K-1.svg");
    always-on-top: true;
    width: 380px;
    height: 440px;

    callback close-requested();

    // Tema senkronizasyonu — Rust set_is_dark() çağrıldığında tetiklenir
    in property <bool> is-dark: true;
    changed is-dark => {
        if (is-dark) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.light;
        }
    }

    VerticalLayout {
        padding: AppTheme.space-xl;
        spacing: AppTheme.space-md;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("./assets/Yörü-K-1.svg");
                width: 96px;
                height: 96px;
                horizontal-alignment: center;
            }
        }

        Text {
            text: "Yörü-K İKA Kontrol Sistemi";
            color: AppTheme.text-primary;
            font-size: AppTheme.font-xl;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "v0.1.0";
            color: AppTheme.text-tertiary;
            font-size: AppTheme.font-sm;
            horizontal-alignment: center;
        }

        TSeparator { }

        Text {
            text: "Yörü-K diferansiyel sürüşlü İKA kontrol yazılımı";
            color: AppTheme.text-secondary;
            font-size: AppTheme.font-lg;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Rust + Slint + ONNX Runtime kullanarak Toroslar Atatürk MTAL Yörü-K Teknoloji Takımı tarafından üretilmiştir.";
            color: AppTheme.text-tertiary;
            font-size: AppTheme.font-md;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            text: "Kapat";
            clicked => { root.close-requested(); }
        }
    }
}
