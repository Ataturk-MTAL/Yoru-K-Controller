import { AppState }        from "state.slint";
import { Theme }           from "theme.slint";
import { ConnectionPanel } from "components/connection_panel.slint";
import { MotorControl }    from "components/motor_control.slint";
import { JoystickPanel }   from "components/joystick_panel.slint";
import { SpeedDisplay }    from "components/speed_display.slint";
import { CameraView }      from "components/camera_view.slint";
import { MapView }         from "components/map_view.slint";
import { TabWidget, Palette } from "std-widgets.slint";

export { AppState }

export component AppWindow inherits Window {
    title: "Yörü-K Kontrolcü";
    background: Theme.bg-dark;
    min-width:  1100px;
    min-height: 680px;
    preferred-width:  1280px;
    preferred-height: 800px;

    // ── Rust'a callback'ler ──────────────────────────────
    callback connect-serial(string, int);
    callback connect-tcp(string, int);
    callback disconnect();
    callback refresh-ports();
    callback send-start();
    callback send-stop();
    callback send-light(bool);
    callback send-brake(bool);
    callback set-gear(int);
    callback set-reverse-left(bool);
    callback set-reverse-right(bool);
    callback joystick-moved(float, float, float);
    callback joystick-released();
    callback start-camera(int);
    callback stop-camera();
    callback enable-gps();
    callback disable-gps();

    // Dark tema zorla — tüm native widgetları (Button, ComboBox, SpinBox vb.) etkiler
    init => { Palette.color-scheme = ColorScheme.dark; }

    // Yardım dialog görünürlüğü
    property <bool> help-visible: false;

    // ── MenuBar ──────────────────────────────────────────
    MenuBar {
        Menu {
            title: "Bağlantı";
            MenuItem {
                title: "Bağlantıyı Kes";
                activated => { root.disconnect(); }
            }
        }
        Menu {
            title: "Motor";
            MenuItem { title: "Başlat"; activated => { root.send-start(); } }
            MenuItem { title: "Durdur"; activated => { root.send-stop(); } }
            MenuItem { title: "Işık";   activated => { root.send-light(!AppState.light-on); } }
            MenuItem { title: "Fren";   activated => { root.send-brake(!AppState.brake-on); } }
        }
        Menu {
            title: "Yardım";
            MenuItem {
                title: "Klavye Kısayolları";
                activated => { root.help-visible = !root.help-visible; }
            }
        }
    }

    // ── Klavye focus ─────────────────────────────────────
    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(e) => {
            if (e.text == " ") { root.send-stop(); return accept; }
            if (e.text == "1") { root.set-gear(1); return accept; }
            if (e.text == "2") { root.set-gear(2); return accept; }
            if (e.text == "3") { root.set-gear(3); return accept; }
            if (e.text == "l") { root.send-light(!AppState.light-on); return accept; }
            if (e.text == "b") { root.send-brake(!AppState.brake-on); return accept; }
            if (e.text == "m") { AppState.active-tab = 1; return accept; }
            if (e.text == "c") { AppState.active-tab = 0; return accept; }
            if (e.text == "w" || e.text == Key.UpArrow)    { return accept; }
            if (e.text == "s" || e.text == Key.DownArrow)  { return accept; }
            if (e.text == "a" || e.text == Key.LeftArrow)  { return accept; }
            if (e.text == "d" || e.text == Key.RightArrow) { return accept; }
            reject
        }
        key-released(e) => {
            if (e.text == "w" || e.text == Key.UpArrow)    { return accept; }
            if (e.text == "s" || e.text == Key.DownArrow)  { return accept; }
            if (e.text == "a" || e.text == Key.LeftArrow)  { return accept; }
            if (e.text == "d" || e.text == Key.RightArrow) { return accept; }
            reject
        }

        // ── Ana layout ───────────────────────────────────
        VerticalLayout {
            spacing: 0px;

            // ────────── Üst başlık çubuğu ───────────────
            Rectangle {
                height: 44px;
                background: Theme.bg-card;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left:  Theme.pad-md;
                    padding-right: Theme.pad-md;
                    alignment: center;

                    Text {
                        text: "🤖 YÖRÜ-K";
                        color: Theme.text-primary;
                        font-size: Theme.font-lg;
                        vertical-alignment: center;
                        letter-spacing: 2px;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 8px; height: 8px;
                        border-radius: 4px;
                        background: AppState.connected ? Theme.accent-green : Theme.text-disabled;
                        animate background { duration: 300ms; }
                    }

                    Rectangle { width: Theme.pad-xs; }

                    Text {
                        text: AppState.status-text;
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }

                    Rectangle { width: Theme.pad-md; }

                    if (AppState.motor-running): Text {
                        text: "● Motor";
                        color: Theme.accent-green;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }

                    Rectangle { width: Theme.pad-md; }

                    if (AppState.gps-active && AppState.gps-point-count > 0): Text {
                        text: "🛰 " +
                              round(AppState.gps-lat * 10000) / 10000 + "°  " +
                              round(AppState.gps-lon * 10000) / 10000 + "°";
                        color: Theme.accent-green;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                }
            }

            // ────────── Ana içerik alanı ─────────────────
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // ══ SOL PANEL: TabWidget ══════════════════
                TabWidget {
                    horizontal-stretch: 1;
                    current-index <=> AppState.active-tab;

                    Tab {
                        title: "Kamera";
                        CameraView {
                            start-camera(i) => { root.start-camera(i); }
                            stop-camera()   => { root.stop-camera(); }
                        }
                    }

                    Tab {
                        title: "Harita";
                        MapView {
                            enable-gps()  => { root.enable-gps(); }
                            disable-gps() => { root.disable-gps(); }
                        }
                    }
                }

                // ══ SAĞ PANEL: Kontrol ════════════════════
                Rectangle {
                    width: Theme.panel-width;
                    background: Theme.bg-panel;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding:  Theme.pad-sm;
                        spacing:  Theme.pad-sm;

                        ConnectionPanel {
                            connect-serial(p, b) => { root.connect-serial(p, b); }
                            connect-tcp(h, p)    => { root.connect-tcp(h, p); }
                            disconnect()         => { root.disconnect(); }
                            refresh-ports()      => { root.refresh-ports(); }
                        }

                        MotorControl {
                            start()          => { root.send-start(); }
                            stop()           => { root.send-stop(); }
                            set-gear(g)      => { root.set-gear(g); }
                            set-light(v)     => { root.send-light(v); }
                            set-brake(v)     => { root.send-brake(v); }
                            set-reverse-l(v) => { root.set-reverse-left(v); }
                            set-reverse-r(v) => { root.set-reverse-right(v); }
                        }

                        JoystickPanel {
                            moved(dx, dy, r) => { root.joystick-moved(dx, dy, r); }
                            released()       => { root.joystick-released(); }
                        }

                        SpeedDisplay {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // ── Yardım dialog overlay ────────────────────────────
    // FocusScope dışında, Window'un direkt child'ı — her zaman üstte
    if (help-visible): Rectangle {
        background: #00000066;
        x: 0; y: 0;
        width: root.width;
        height: root.height;

        Rectangle {
            width: 340px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: Theme.pad-md;
                spacing: Theme.pad-sm;

                HorizontalLayout {
                    Text {
                        text: "Klavye Kısayolları";
                        color: Theme.text-primary;
                        font-size: Theme.font-lg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: Theme.bg-panel;
                        Text {
                            text: "✕";
                            color: Theme.text-dim;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.help-visible = false; } }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                for row in [
                    ["W / ↑",     "İleri"],
                    ["S / ↓",     "Geri"],
                    ["A / ←",     "Sol dönüş"],
                    ["D / →",     "Sağ dönüş"],
                    ["Space",     "Acil durdurma"],
                    ["1 / 2 / 3", "Vites seç"],
                    ["L",         "Işık aç/kapat"],
                    ["B",         "Fren aç/kapat"],
                    ["C",         "Kamera sekmesi"],
                    ["M",         "Harita sekmesi"],
                ]: HorizontalLayout {
                    spacing: Theme.pad-sm;
                    Rectangle {
                        width: 90px; height: 22px;
                        background: Theme.bg-panel;
                        border-radius: 3px;
                        Text {
                            text: row[0];
                            color: Theme.accent-yellow;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: row[1];
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }

        TouchArea { clicked => { root.help-visible = false; } }
    }
}
