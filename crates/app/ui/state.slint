// Harita tile yapısı — Flickable içinde konumlanır
export struct MapTile {
    x: length,
    y: length,
    tile: image,
}

// Merkezi uygulama durumu — tüm bileşenler bu global'i okur/yazar
export global AppState {
    // ── Bağlantı ────────────────────────────────────────
    in-out property <bool>     connected:       false;
    in-out property <bool>     is-serial:       true;
    in-out property <string>   status-text:     "Hazır...";
    in-out property <string>   serial-port:     "";
    in-out property <int>      baud-rate:       115200;
    in-out property <string>   tcp-host:        "192.168.4.1";
    in-out property <int>      tcp-port:        80;
    in-out property <[string]> available-ports: [];
    in-out property <bool>     tcp-host-valid:  true;

    // ── Motor durumu ─────────────────────────────────────
    in-out property <bool>  motor-running:     false;
    in-out property <int>   gear:              1;
    in-out property <int>   left-speed:        0;
    in-out property <int>   right-speed:       0;
    in-out property <bool>  reverse-left:      false;
    in-out property <bool>  reverse-right:     false;
    in-out property <int>   send-interval-ms:  30;    // Gönderim aralığı (ms): 10/20/30/40/50

    // ── Periferal ────────────────────────────────────────
    in-out property <bool>  light-on:  false;
    in-out property <bool>  brake-on:  false;

    // ── Kamera ──────────────────────────────────────────
    in-out property <image>    camera-frame;
    in-out property <bool>     camera-running:    false;
    in-out property <int>      camera-fps:        0;
    in-out property <int>      camera-index:      0;
    in-out property <[string]> available-cameras: [];  // "0: FaceTime HD Camera" formatında
    in-out property <string>   camera-error:      "";  // Hata mesajı (boşsa hata yok)
    in-out property <image>    detection-frame;        // Bounding box overlay frame
    in-out property <bool>     detection-enabled: false;
    in-out property <int>      detection-count:   0;  // Tespit edilen nesne sayısı

    // ── GPS / Harita ─────────────────────────────────────
    in-out property <bool>  gps-active:      false;  // GPS yayını açık mı?
    in-out property <float> gps-lat:         0.0;    // Son enlem
    in-out property <float> gps-lon:         0.0;    // Son boylam
    in-out property <float> gps-lat-min:     0.0;    // İz sınırı: min enlem
    in-out property <float> gps-lat-max:     0.0;    // İz sınırı: max enlem
    in-out property <float> gps-lon-min:     0.0;    // İz sınırı: min boylam
    in-out property <float> gps-lon-max:     0.0;    // İz sınırı: max boylam
    in-out property <int>   gps-point-count: 0;      // Toplam iz noktası sayısı

    // ── Harita tile'ları ──────────────────────────────────
    in property <[MapTile]> map-tiles;
    in-out property <int>   map-zoom: 15;            // OSM zoom seviyesi (1-19)
    in property <length>    map-marker-x;            // Robot marker pixel pozisyonu
    in property <length>    map-marker-y;

    // ── Sol panel aktif sekme ────────────────────────────
    in-out property <int>   active-tab: 0;           // 0 = Kamera, 1 = Harita

    // ── Tema durumu (AboutWindow senkronizasyonu için) ──
    in-out property <bool>  is-dark: true;
}
