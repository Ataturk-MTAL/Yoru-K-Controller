// Tema sabitleri — tüm bileşenler bu global'i import eder
export global Theme {
    // ── Renkler ─────────────────────────────────────────
    out property <color> bg-dark:        #1a1a2e;
    out property <color> bg-panel:       #16213e;
    out property <color> bg-card:        #0f3460;
    out property <color> bg-card-hover:  #1a4a80;
    out property <color> accent:         #e94560;
    out property <color> accent-hover:   #ff6b6b;
    out property <color> accent-green:   #4caf50;
    out property <color> accent-green-h: #66bb6a;
    out property <color> accent-yellow:  #ffc107;
    out property <color> text-primary:   #eaeaea;
    out property <color> text-dim:       #888888;
    out property <color> text-disabled:  #444444;
    out property <color> border:         #2a3f6f;
    out property <color> border-active:  #4caf50;

    // ── Spacing ─────────────────────────────────────────
    out property <length> pad-xs:  4px;
    out property <length> pad-sm:  8px;
    out property <length> pad-md:  14px;
    out property <length> pad-lg:  20px;
    out property <length> radius:  6px;
    out property <length> radius-lg: 12px;

    // ── Sağ panel genişliği ──────────────────────────────
    out property <length> panel-width: 320px;

    // ── Font boyutları ───────────────────────────────────
    out property <length> font-sm:   11px;
    out property <length> font-md:   13px;
    out property <length> font-lg:   16px;
    out property <length> font-xl:   20px;
    out property <length> font-xxl:  28px;
}
